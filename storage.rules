rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function isImageUnder(bytes) {
      return request.resource.size < bytes
        && request.resource.contentType.matches('image/.*');
    }

    // Current uploads use memories/{uid}/... (not a diary ID).
    // Legacy diary-ID folders require an ownership audit before migration.
    match /memories/{userId}/{allPaths=**} {
      allow read, delete: if isOwner(userId);
      allow create, update: if isOwner(userId)
        && isImageUnder(10 * 1024 * 1024);
    }

    match /images/{userId}/{allPaths=**} {
      allow read, delete: if isOwner(userId);
      allow create, update: if isOwner(userId)
        && isImageUnder(10 * 1024 * 1024);
    }

    // Profiles are private too: this app no longer exposes public photos.
    match /profiles/{userId}/{fileName} {
      allow read, delete: if isOwner(userId);
      allow create, update: if isOwner(userId)
        && isImageUnder(5 * 1024 * 1024);
    }

    // Retired sharing path. Preserve stored objects; do not publish them.
    match /shared/{shareId}/{allPaths=**} {
      allow read, write: if false;
    }
    
    // デフォルトルール（その他のパスへのアクセスを拒否）
    match /{allPaths=**} {
      allow read: if false;
      allow write: if false;
    }
  }
}
